<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskManager.ViewModels"
        xmlns:controls="clr-namespace:TaskManager.Controls"
        xmlns:models="clr-namespace:TaskManager.Models"
        x:Class="TaskManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        
        Width="800" Height="600"
        Title="Task Manager">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
            <TextBox Width="200" Watermark="Tytuł" Text="{Binding NewTitle}"/>
            <TextBox Width="300" Watermark="Opis" Text="{Binding NewDescription}"/>
            <Button Content="Dodaj" Command="{Binding AddCommand}"/>
            <Button Content="Odśwież" Command="{Binding LoadCommand}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <TextBlock Text="Wszystkie:"/>
            <TextBlock Text="{Binding Stats.Total}"/>
            <TextBlock Text="Ukończone:" Margin="10,0,0,0"/>
            <TextBlock Text="{Binding Stats.Completed}"/>
            <TextBlock Text="Procent:" Margin="10,0,0,0"/>
            <TextBlock Text="{Binding Stats.CompletionPercent, StringFormat='0.0 %'}"/>
        </StackPanel>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:TodoTask">
                        <controls:TaskCard/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>